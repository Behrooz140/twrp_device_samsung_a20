# Android fstab file for TWRP / OrangeFox (Samsung Exynos 7884)

# Dynamic / Main Partitions (Auto FS type for EROFS / EXT4 support)
/system_root        auto    /dev/block/platform/13500000.dwmmc0/by-name/system        flags=display="System";backup=1;wipeingui
/system_image       emmc    /dev/block/platform/13500000.dwmmc0/by-name/system        flags=display="System Image";backup=1;flashimg=1
/vendor             auto    /dev/block/platform/13500000.dwmmc0/by-name/vendor        flags=display="Vendor";backup=1;wipeingui
/vendor_image       emmc    /dev/block/platform/13500000.dwmmc0/by-name/vendor        flags=display="Vendor Image";backup=1;flashimg=1
/product            auto    /dev/block/platform/13500000.dwmmc0/by-name/product       flags=display="Product";backup=1;wipeingui
/product_image      emmc    /dev/block/platform/13500000.dwmmc0/by-name/product       flags=display="Product Image (CSC)";backup=1;flashimg=1
/omr                auto    /dev/block/platform/13500000.dwmmc0/by-name/omr           flags=display="OMR";backup=1;wipeingui
/omr_image          emmc    /dev/block/platform/13500000.dwmmc0/by-name/omr           flags=display="OMR Image";backup=1;flashimg=1

# Core Firmware Partitions
/boot               emmc    /dev/block/platform/13500000.dwmmc0/by-name/boot          flags=display="Kernel Image";backup=1;flashimg=1
/dtbo               emmc    /dev/block/platform/13500000.dwmmc0/by-name/dtbo          flags=display="DTBO Image";backup=1;flashimg=1
/recovery           emmc    /dev/block/platform/13500000.dwmmc0/by-name/recovery      flags=display="Recovery Image";backup=1;flashimg=1

# User Data & Cache (EXT4 & F2FS support)
/cache              auto    /dev/block/platform/13500000.dwmmc0/by-name/cache         flags=display="Cache";backup=1;wipeingui
/data               auto    /dev/block/platform/13500000.dwmmc0/by-name/userdata      flags=display="Data";encryptable=footer;length=-20480
/efs                ext4    /dev/block/platform/13500000.dwmmc0/by-name/efs           flags=display="EFS";backup=1

# External Storage
/external_sd        auto    /dev/block/mmcblk1p1 /dev/block/mmcblk1                   flags=fsflags=utf8;display="Micro SDcard";storage;wipeingui;removable
/usb-otg            auto    /dev/block/sda1      /dev/block/sda                       flags=display="USB-OTG";storage;wipeingui;removable
